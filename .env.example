DB_HOST=YOUR_HOST
DB_PORT=YOUR_PORT

MYSQL_DATABASE=YOUR_DB_NAME
MYSQL_USER=YOUR_USERNAME
MYSQL_PASSWORD=YOUR_PASSWORD
MYSQL_ROOT_PASSWORD=YOUR_ROOT_PASSWORD

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
# false khi chạy HTTP local. Profile prod luôn bật cookie-secure.
JWT_COOKIE_SECURE=false

# Gmail + App Password (bắt buộc: đăng ký tài khoản cần mail xác thực)
MAIL_USERNAME=YOUR_MAIL
MAIL_PASSWORD=YOUR_APP_PASSWORD

# AES-256 master key (Base64, 32 byte). KHÔNG commit key thật.
# Sinh key: xem README mục 3
CRYPTO_MASTER_KEY=YOUR_BASE64_32_BYTE_KEY

# KYC Owner: khóa HMAC riêng cho số CCCD/CMND (Base64, >= 32 byte). Để trống = suy ra từ CRYPTO_MASTER_KEY.
# Đổi khóa này thì phải tính lại hash CCCD đã lưu.
# IDENTITY_HMAC_KEY=
# OTP số điện thoại khi xác minh danh tính: true = chế độ thử nghiệm, mã hiện trên màn hình (chưa có SMS thật).
KYC_SMS_SANDBOX=true

# Địa chỉ frontend, dùng tạo link trong email gửi Beneficiary.
# Mặc định http://localhost:5173 (Vite). BẮT BUỘC đặt khi deploy, nếu không mail sẽ chứa link localhost.
FRONTEND_BASE_URL=http://localhost:5173

# Tự tạo tài khoản Admin ở lần khởi động đầu (để trống = không tạo)
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# H1: nơi lưu file. local = thư mục uploads/ (mặc định); s3 = MinIO / Cloudflare R2 / AWS S3.
APP_STORAGE_PROVIDER=local
# Thư mục lưu file khi APP_STORAGE_PROVIDER=local (mặc định uploads/)
# APP_STORAGE_UPLOAD_DIR=uploads/
# true: lần khởi động tới đưa file cũ trong uploads/ lên bucket rồi đổi đường dẫn trong DB (chạy lại không sao).
# Chỉ bật cho MỘT lần khởi động rồi tắt lại: khi đang bật mà không kết nối được bucket thì app không khởi động.
# DB mới tinh (deploy Azure lần đầu) không có file cũ, không cần bật.
APP_STORAGE_MIGRATE_LOCAL=false
# MinIO trong docker-compose: S3_ENDPOINT=http://localhost:9000, key/secret = MINIO_ROOT_USER/MINIO_ROOT_PASSWORD
# Cloudflare R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=legacyvault
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_S3_SECRET_KEY
S3_PATH_STYLE=true
MINIO_ROOT_USER=YOUR_MINIO_USER
MINIO_ROOT_PASSWORD=YOUR_MINIO_PASSWORD_MIN_8_CHARS

# PayPal (sandbox): lấy client id / secret ở developer.paypal.com. Để trống thì cổng PayPal tự ẩn. KHÔNG commit giá trị thật.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# VNPay (sandbox): lấy TMN code / hash secret từ cổng merchant. KHÔNG commit giá trị thật.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# URL BACKEND mà VNPay redirect trình duyệt về sau thanh toán (endpoint /api/payments/vnpay-return).
# Không đặt = mặc định http://localhost:8084/api/payments/vnpay-return trong application.yaml.
# Production: bỏ comment và đặt theo domain thật (đặt rỗng mà vẫn export thì return-url thành chuỗi rỗng).
# VNPAY_RETURN_URL=https://legacyvault.codes/api/payments/vnpay-return
# Không đặt = dùng URL sandbox mặc định trong application.yaml. Production: bỏ comment và đặt URL cổng thanh toán thật
# (đặt rỗng mà vẫn export thì pay-url thành chuỗi rỗng).
# VNPAY_PAY_URL=https://<url-cong-thanh-toan-vnpay-production>
# Chỉ dùng khi thử sandbox trên máy (VNPay không gọi IPN về localhost được): kích hoạt gói ngay khi quay về return-url.
# KHÔNG BAO GIỜ đặt trên Azure/production.
# APP_VNPAY_ACTIVATEONRETURN=true

# Trợ lý AI: mock (không cần key) hoặc gemini
AI_PROVIDER=mock
GEMINI_API_KEY=
# Tuỳ chọn: key dự phòng từ tài khoản Google khác (để trống thì tự dùng chung GEMINI_API_KEY)
# GEMINI_BACKUP_API_KEY=
# Không đặt = gemini-3.6-flash (mặc định trong application.yaml)
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_BACKUP_MODEL=gemini-3.5-flash

# Đăng nhập bằng Google: OAuth Client ID loại Web application. Để trống = ẩn nút Google.
# Authorized JavaScript origins: http://localhost:5173, http://localhost:8084, https://legacyvault.codes
GOOGLE_CLIENT_ID=

# Production (Azure App Settings), KHÔNG đặt trong .env local:
# SPRING_PROFILES_ACTIVE=prod
# WEBSITES_PORT=8084
# FRONTEND_BASE_URL=https://legacyvault.codes
# APP_STORAGE_PROVIDER=s3 (Cloudflare R2)
