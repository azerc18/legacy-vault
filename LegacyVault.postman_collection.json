{
	"info": {
		"_postman_id": "a823b128-89c4-4b5c-a50d-6e8979d39b81",
		"name": "Legacy Vault API",
		"description": "Postman Collection for Legacy Vault APIs (Auth, Digital Executor FR-07/FR-08, Vaults, Verifier)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8084",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "assignmentId",
			"value": "44444444-4444-4444-4444-444444444444",
			"type": "string"
		},
		{
			"key": "vaultId",
			"value": "22222222-2222-2222-2222-222222222222",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Login (Digital Executor)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.accessToken) {",
									"        pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
									"        console.log('Access token saved successfully!');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"executor@legacyvault.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Đăng nhập với tài khoản Executor đã tạo sẵn. Token JWT sẽ tự động được lưu vào biến collection `accessToken`."
					},
					"response": []
				},
				{
					"name": "Register New Account",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"testuser@legacyvault.com\",\n  \"fullName\": \"Test User\",\n  \"password\": \"Password123!\",\n  \"passwordConfirm\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Digital Executor (Person 4)",
			"item": [
				{
					"name": "FR-07: Acknowledge Activation",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/executor-assignments/{{assignmentId}}/acknowledge",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"executor-assignments",
								"{{assignmentId}}",
								"acknowledge"
							]
						},
						"description": "Digital Executor xác nhận đã nhận thông báo kích hoạt DMS."
					},
					"response": []
				},
				{
					"name": "FR-08: Submit Death Verification Request",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": [],
									"description": "Chọn 1 file tài liệu (PDF, PNG, JPG <= 10MB)"
								},
								{
									"key": "vaultIds",
									"value": "{{vaultId}}",
									"type": "text",
									"description": "UUID của vault cần mở khóa"
								},
								{
									"key": "notes",
									"value": "Nộp giấy chứng tử để xác minh mở khoá vault theo di nguyện.",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/executor-assignments/{{assignmentId}}/verification-requests",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"executor-assignments",
								"{{assignmentId}}",
								"verification-requests"
							]
						},
						"description": "Nộp hồ sơ xác minh cái chết (kèm file tài liệu chứng tử, mã hóa và lưu trữ bảo mật)."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Vaults",
			"item": [
				{
					"name": "Create Vault",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Két sắt tài chính cá nhân\",\n  \"description\": \"Chứa hợp đồng bảo hiểm và sổ tiết kiệm\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/vaults",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"vaults"
							]
						}
					},
					"response": []
				},
				{
					"name": "Delete Vault",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/vaults/{{vaultId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"vaults",
								"{{vaultId}}"
							]
						}
					},
					"response": []
				}
			]
		}
	]
}
